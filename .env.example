# ---------------------------------------------------------------------------
# CM Kerala Grievance Portal — environment configuration (copy to .env)
# NEVER commit a real .env. No real secrets belong in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://cmk:cmk@localhost:5432/cmk_grievance
# Set to true for hosted databases that require TLS (Neon, Supabase, Render external URL)
DATABASE_SSL=false

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Seed fictional demo data automatically when the database is empty
SEED_ON_START=true

# Only needed if the frontend is served from a different origin (comma-separated)
CORS_ORIGIN=

# Uploads & SLA
MAX_UPLOAD_MB=5
DEFAULT_SLA_DAYS=15

# ---------------------------------------------------------------------------
# AI Grievance Assistant
# AI_PROVIDER: auto | gemini | openai | anthropic | fallback
#   auto = first provider below that has a key. With no key, a clearly
#   labelled heuristic fallback is used (and shown as such in the UI).
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
AI_TIMEOUT_MS=20000
AI_DUPLICATE_THRESHOLD=0.42

# Google Gemini (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local Ollama ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# e.g. Groq (free tier): OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
